{
  "dashboard": {
    "title": "LightPulse APM - System Monitor",
    "tags": ["lightpulse", "apm", "monitoring"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "JVM 堆内存使用率",
        "type": "graph",
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{area=\"heap\"} / jvm_memory_max_bytes{area=\"heap\"} * 100",
            "legendFormat": "{{ instance }}"
          }
        ],
        "yaxes": [
          {
            "format": "percent",
            "max": 100,
            "min": 0
          }
        ]
      },
      {
        "id": 2,
        "title": "CPU 使用率",
        "type": "graph",
        "targets": [
          {
            "expr": "system_cpu_usage * 100",
            "legendFormat": "CPU Usage"
          }
        ]
      },
      {
        "id": 3,
        "title": "HTTP 请求 QPS",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count[1m])",
            "legendFormat": "{{ uri }}"
          }
        ]
      },
      {
        "id": 4,
        "title": "API 响应时间 (P95/P99)",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "P95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_server_requests_seconds_bucket[5m]))",
            "legendFormat": "P99"
          }
        ]
      },
      {
        "id": 5,
        "title": "GC 暂停时间",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(jvm_gc_pause_seconds_sum[1m])",
            "legendFormat": "{{ action }}"
          }
        ]
      },
      {
        "id": 6,
        "title": "数据库连接池",
        "type": "graph",
        "targets": [
          {
            "expr": "hikaricp_connections_active",
            "legendFormat": "Active"
          },
          {
            "expr": "hikaricp_connections_idle",
            "legendFormat": "Idle"
          },
          {
            "expr": "hikaricp_connections_max",
            "legendFormat": "Max"
          }
        ]
      },
      {
        "id": 7,
        "title": "Agent 心跳速率",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(lightpulse_agent_heartbeat_total[1m])",
            "legendFormat": "{{ app }}"
          }
        ]
      },
      {
        "id": 8,
        "title": "接收指标数量",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(lightpulse_metrics_received_total[1m])",
            "legendFormat": "{{ app }}"
          }
        ]
      },
      {
        "id": 9,
        "title": "批量插入性能 (TPS)",
        "type": "graph",
        "targets": [
          {
            "expr": "lightpulse_batch_insert_tps",
            "legendFormat": "Insert TPS"
          }
        ]
      }
    ],
    "refresh": "10s"
  }
}
